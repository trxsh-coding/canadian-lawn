{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "lawn_type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::lawn-type.lawn-type",
      "configurable": true,
      "visible": true,
      "conditions": {
        "visible": {
          "==": [{ "var": "type" }, "lawn"]
        }
      }
    },
    "brand": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::brand.brand",
      "conditions": {
        "visible": {
          "==": [{ "var": "type" }, "lawn"]
        }
      }
    },
    "features": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::feature.feature",
      "conditions": {
        "visible": {
          "==": [{ "var": "type" }, "lawn"]
        }
      }
    },
    "name": {
      "type": "string",
      "maxLength": 255,
      "required": true
    },
    "slug": {
      "type": "uid",
      "required": true
    },
    "partner": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::partner.partner"
    },
    "price": {
      "type": "integer",
      "required": true
    },
    "old_price": {
      "type": "integer"
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "videos",
        "images"
      ]
    },
    "sku": {
      "type": "string"
    },
    "quantity": {
      "type": "integer"
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "lawn",
        "lawn-mix",
        "tractor",
        "technique"
      ]
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "products"
    },
    "lawn": {
      "type": "component",
      "conditions": {
        "visible": {
          "in": [{ "var": "type" }, ["lawn", "lawn-mix"]]
        }
      },
      "component": "products.lawn-single",
      "repeatable": false
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "lawns": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "conditions": {
        "visible": {
          "==": [{ "var": "type" }, "lawn-mix"]
        }
      }
    },
    "characteristic": {
      "type": "component",
      "component": "common.characteristic",
      "repeatable": true,
      "conditions": {
        "visible": {
          "in": [{ "var": "type" }, ["tractor", "technique"]]
        }
      }
    }
  }
}
